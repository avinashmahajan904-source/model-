# Groq Cloud API Key
# 1. Sign up for a free Groq account at: https://console.groq.com/
# 2. Generate an API Key at: https://console.groq.com/keys
# 3. Rename this file to '.env' and paste your key below:
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Host and Port configuration (useful for custom server setups)
HOST=0.0.0.0
PORT=5000
